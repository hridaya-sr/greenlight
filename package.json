{
  "name": "greenlight",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "samples": "tsx scripts/generate-samples.ts",
    "irs:load": "tsx scripts/load-irs.ts",
    "setup": "prisma db push && prisma generate && npm run samples && npm run db:seed && npm run irs:load -- --sample",
    "postinstall": "prisma generate",
    "setup:vercel": "tsx scripts/setup-vercel.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@vercel/blob": "^2.8.2",
    "exceljs": "^4.4.0",
    "next": "16.4.2",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "prisma": "^7.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "unpdf": "^1.9.1",
    "unzipper": "^0.12.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/unzipper": "^0.10.11",
    "dotenv": "^18.0.8",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
