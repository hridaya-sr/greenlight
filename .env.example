# Local SQLite database (created by `npm run db:push`)
DATABASE_URL="file:./dev.db"

# Required for document extraction
ANTHROPIC_API_KEY=""

# Where uploaded files are stored in dev
# "local" or "blob". If unset, Blob is used when BLOB_STORE_ID or BLOB_READ_WRITE_TOKEN is present.
STORAGE_DIR="./storage"

# Used to build chapter upload links in email previews
APP_URL="http://localhost:3000"
